{
  "name": "interjson-moonbit",
  "version": "1.4.0",
  "description": "The local execution gate for LLM output, as a Model Context Protocol server and a library, powered by the MoonBit engine.",
  "license": "Apache-2.0",
  "type": "commonjs",
  "main": "./index.cjs",
  "module": "./index.mjs",
  "types": "./index.d.ts",
  "exports": {
    ".": {
      "types": "./index.d.ts",
      "import": "./index.mjs",
      "require": "./index.cjs"
    }
  },
  "files": [
    "index.cjs",
    "index.mjs",
    "index.d.ts",
    "mcp.cjs",
    "vendor/interjson.js",
    "README.md"
  ],
  "scripts": {
    "build": "bash build.sh",
    "test": "node --test"
  },
  "engines": {
    "node": ">=18"
  },
  "keywords": [
    "json",
    "repair",
    "streaming",
    "llm",
    "tool-call",
    "mcp",
    "execution-gate",
    "moonbit"
  ],
  "bin": {
    "interjson-mcp": "./mcp.cjs"
  }
}
