{
  "name": "jsonmend-moonbit",
  "version": "1.1.0",
  "description": "Streaming JSON repair and an execution gate for LLM tool calls, powered by the MoonBit engine.",
  "license": "Apache-2.0",
  "type": "commonjs",
  "main": "./index.cjs",
  "module": "./index.mjs",
  "types": "./index.d.ts",
  "exports": {
    ".": {
      "types": "./index.d.ts",
      "import": "./index.mjs",
      "require": "./index.cjs"
    }
  },
  "files": [
    "index.cjs",
    "index.mjs",
    "index.d.ts",
    "vendor/jsonmend.js",
    "README.md"
  ],
  "scripts": {
    "build": "bash build.sh",
    "test": "node --test"
  },
  "engines": {
    "node": ">=18"
  },
  "keywords": [
    "json",
    "repair",
    "streaming",
    "llm",
    "tool-call",
    "moonbit"
  ]
}
