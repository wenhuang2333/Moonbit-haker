# macOS
.DS_Store

# MoonBit 构建产物
target/
_build/
.mooncakes/
moon.lock

# ── 文档提交流程（2026-10-25 起生效的规则）────────────────────────────
#
# 只允许 README 类文件与「流水线读取的文件」进 GitHub，其余文档一律只在本地
# 保留。用白名单而不是黑名单：新增一篇文档时默认**不上传**，要上传必须在这里
# 显式放行。黑名单的默认是上传——漏一条就悄悄多传了一个文件。
#
# 放行的文档及理由：
#   README.md / **/README.md / **/README.zh.md
#                                 仓库首页；各子包 README 被 mooncakes、npm、
#                                 PyPI 的包页直接读取，删了包页就空了
#   code/CHANGELOG.md             release.yml 从它抽取每个版本的 Release 正文；
#                                 属于发布元数据，不是说明文档
#   code/docs/EVAL*.md            CI 跑出来的测量报告，由 run_eval.py、
#   code/docs/READINESS.md        run_independent.py、run_readiness.py、
#   code/docs/MEMORY.md           memory_baseline.py 直接写入，CI 还把它们
#                                当 artifact 上传
#   code/docs/DIVERGENCES.md      差分报告，run_diff.py 写入
#   code/tests/eval/third_party/** 第三方语料的 README/PROVENANCE：许可证要求
#                                 随代码一起分发，删了不合规
#
# 其余文档（code/docs/ 的设计文档、marks/、产品文档*.md、过程文档、
# .github/ 模板、AGENTS.md）只在本地保留。
*.md
!README.md
!**/README.md
!**/README.zh.md
!code/CHANGELOG.md
!code/docs/EVAL.md
!code/docs/EVAL_AMBIGUITY.md
!code/docs/EVAL_INDEPENDENT.md
!code/docs/EVAL_PATHS.md
!code/docs/EVAL_REFERENCE.md
!code/docs/EVAL_REGISTRATION.md
!code/docs/READINESS.md
!code/docs/MEMORY.md
!code/docs/DIVERGENCES.md
!code/tests/eval/third_party/**

# 差分报告的本地副本（提交版是 docs/DIVERGENCES.md）
code/tests/diff/report.md

# 本地文档与截图目录（工作区约定：marks/ 只在本地保留）。`*.md` 已被上面的
# 白名单挡掉，但截图不是 .md，漏一条就会把本地素材带进仓库。
marks/

# 覆盖率产物
*.coverage
moonbit_coverage_*

# 临时脚本目录（工作区约定：一次性脚本放 test/）
test/

# Node
node_modules/
dist/

# Python
__pycache__/
*.pyc
.venv/
build/
*.egg-info/

# 环境变量与密钥（敏感信息严禁上传）
.env
*.key
*.pem
*.ppk
id_rsa*
id_ed25519*
id_ecdsa*
*.p12
*.pfx
gh_token*.txt
device_code*.txt
